<!DOCTYPE html>
<html lang="en">
    <head>
        {% include "head.j2" %}
        {% if json_ld %}
            <script type="application/ld+json">{{ json_ld | tojson }}</script>
        {% endif %}
    </head>
    <body>
        <main class="container">
            {% block content %}{% endblock %}
        </main>
        <script>
            if (window.matchMedia) {
                const m = window.matchMedia('(prefers-color-scheme: dark)');
                document.body.setAttribute('data-bs-theme', m.matches ? 'dark' : 'light');
                m.addEventListener('change', e => document.body.setAttribute('data-bs-theme', e.matches ? 'dark' : 'light'));
            }
        </script>
    </body>
</html>
