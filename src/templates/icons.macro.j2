        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
    >
        <circle cx="5" cy="12" r="3" />
        <circle cx="19" cy="12" r="3" />
        <line x1="8" y1="12" x2="16" y2="12" />
    </svg>
{% endmacro %}
